# MACIE Core Shell environment template
# Copy to .env and fill in. Never commit .env.

# Model API keys (Core Shell only — engine adapters read these at runtime)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cloudflare Access — Core Shell route protection
CLOUDFLARE_ACCESS_AUD=
CLOUDFLARE_ACCESS_TEAM_DOMAIN=

# Allowlist (Phase 1: Pete + Pete Jr. only)
ALLOWED_ADMIN_EMAILS=
ALLOWED_TESTER_EMAILS=

# Audit log destination (append-only)
AUDIT_LOG_PATH=./audit/macie.log

# Environment marker
MACIE_ENV=development

# OpenRouter native-control provisioning for MACIE rotation
# Management key is administrative only; never expose it to product clients.
OPENROUTER_MGMT_KEY=
OPENROUTER_API_KEY=
OPENROUTER_KEY_HASH=
OPENROUTER_GUARDRAIL_ID=
# Pete-approved hard spend cap; required before rotation can create/deploy a new key.
OPENROUTER_KEY_LIMIT_USD=
# daily | weekly | monthly
OPENROUTER_KEY_LIMIT_RESET=
# Exact OpenRouter model slugs, comma-separated
OPENROUTER_ALLOWED_MODELS=
# Exact OpenRouter provider slugs, comma-separated
OPENROUTER_ALLOWED_PROVIDERS=

# Render rotation/deployment controls
RENDER_API_KEY=
RENDER_SERVICE_ID=
RENDER_DEPLOY_HOOK=
MACIE_ADMIN_KEY=
